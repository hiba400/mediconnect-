# MediConnect Environment Configuration Example
# Copy this file to .env and update with your actual values

# Frontend Configuration
VITE_API_URL=/api
VITE_DOCTOR_SERVICE_URL=http://localhost:5196/api
VITE_MESSAGING_SERVICE_URL=/api
VITE_CHAT_HUB_URL=http://localhost:5197/hubs/chat

# Backend Services (for Docker Compose)
# These are typically set in docker-compose.yml
# ConnectionStrings__DefaultConnection=Host=db;Database=mediconnect;Username=postgres;Password=your_password
# Jwt__Key=your-super-secret-key-change-in-production
# Jwt__Issuer=MediConnect
# Jwt__Audience=MediConnectUsers
# Jwt__DurationInMinutes=60
# MessagingService__Url=http://messaging-service:8080/api

# AI Service
# OPENAI_API_KEY=your-openai-api-key-or-mock
